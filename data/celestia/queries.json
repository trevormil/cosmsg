  {
    "service": "celestia.core.v1.gas_estimation.GasEstimator",
    "method": "EstimateGasPrice",
    "package": "celestia.core.v1.gas_estimation",
    "module": "core",
    "requestType": "celestia.core.v1.gas_estimation.EstimateGasPriceRequest",
    "responseType": "celestia.core.v1.gas_estimation.EstimateGasPriceResponse",
    "requestFields": [
      {
        "name": "tx_priority",
        "type": "celestia.core.v1.gas_estimation.TxPriority",
        "number": 1,
        "repeated": false,
        "optional": false,
        "typeRef": "celestia.core.v1.gas_estimation.TxPriority"
      }
    ],
    "comment": "estimateGasPrice takes a transaction priority and estimates the gas price\n based on the gas prices of the transactions in the last five blocks. If no\n transaction is found in the last five blocks, return the network min gas\n price. It's up to the light client to set the gas price in this case to the\n minimum gas price set by that node."
  },
  {
    "service": "celestia.core.v1.gas_estimation.GasEstimator",
    "method": "EstimateGasPriceAndUsage",
    "package": "celestia.core.v1.gas_estimation",
    "module": "core",
    "requestType": "celestia.core.v1.gas_estimation.EstimateGasPriceAndUsageRequest",
    "responseType": "celestia.core.v1.gas_estimation.EstimateGasPriceAndUsageResponse",
    "requestFields": [
      {
        "name": "tx_priority",
        "type": "celestia.core.v1.gas_estimation.TxPriority",
        "number": 1,
        "repeated": false,
        "optional": false,
        "typeRef": "celestia.core.v1.gas_estimation.TxPriority"
      },
      {
        "name": "tx_bytes",
        "type": "bytes",
        "number": 2,
        "repeated": false,
        "optional": false
      }
    ],
    "comment": "EstimateGasPriceAndUsage takes a transaction priority and a transaction\n bytes and estimates the gas price and the gas used for that transaction.\n The gas price estimation is based on the gas prices of the transactions in\n the last five blocks. If no transaction is found in the last five blocks,\n return the network min gas price. It's up to the light client to set the\n gas price in this case to the minimum gas price set by that node. The gas\n used is estimated using the state machine simulation."
  },
