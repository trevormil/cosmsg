  {
    "typeUrl": "/osmosis.tokenfactory.v1beta1.MsgCreateDenom",
    "name": "MsgCreateDenom",
    "package": "osmosis.tokenfactory.v1beta1",
    "module": "tokenfactory",
    "signers": [
      "sender"
    ],
    "fields": [
      {
        "name": "sender",
        "type": "string",
        "number": 1,
        "repeated": false,
        "optional": false
      },
      {
        "name": "subdenom",
        "type": "string",
        "number": 2,
        "repeated": false,
        "optional": false,
        "comment": "subdenom can be up to 44 \"alphanumeric\" characters long."
      }
    ],
    "comment": "MsgCreateDenom defines the message structure for the CreateDenom gRPC service\n method. It allows an account to create a new denom. It requires a sender\n address and a sub denomination. The (sender_address, sub_denomination) tuple\n must be unique and cannot be re-used.\n\n The resulting denom created is defined as\n <factory/{creatorAddress}/{subdenom}>. The resulting denom's admin is\n originally set to be the creator, but this can be changed later. The token\n denom does not indicate the current admin."
  },
